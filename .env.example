# ── Focus Grove environment ──────────────────────────────────────────
# Copy to .env.local and fill in what you need. Everything is optional:
# with no env file the app runs in mock auth mode.

# Public site metadata (safe to customize; also see the committed .env file)
#VITE_SITE_URL=https://focusgrove.app
#VITE_SITE_NAME=Focus Grove
#VITE_OG_IMAGE_URL=/og-image.png
#VITE_TWITTER_HANDLE=@focusgrove

# Which auth backend to use: mock | firebase | supabase
# Optional — when unset, Supabase is auto-selected if its keys below are
# filled in, otherwise the app runs in mock mode (no credentials needed).
#VITE_AUTH_PROVIDER=supabase

# Firebase (used when VITE_AUTH_PROVIDER=firebase — see src/auth/firebaseAdapter.ts)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Supabase (auto-detected when both are set — see src/lib/supabase.ts)
# ⚠️ anon key ONLY — never put the service-role key in frontend env vars.
# After filling these in, run supabase/schema.sql in your project's SQL
# editor to create the tables, RLS policies, and profile trigger.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
